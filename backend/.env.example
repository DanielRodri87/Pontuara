# Copie este arquivo para `.env` e preencha com os valores reais.
# NUNCA faça commit do `.env` real (ele está no .gitignore).

APP_NAME=Pontuara API
APP_VERSION=0.1.0

# Projeto Supabase
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_KEY=sua-chave-anon-ou-service-role
SUPABASE_SCHEMA=public
SUPABASE_TIMEOUT=15

# Origens permitidas para CORS (separadas por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Nomes das tabelas
SUPABASE_USUARIOS_TABLE=usuarios
SUPABASE_TRABALHOS_TABLE=trabalhos
SUPABASE_EXPEDIENTES_TABLE=expedientes
